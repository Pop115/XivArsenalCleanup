<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    Where Dalamud's assemblies live. DALAMUD_HOME comes first so a machine with no XIVLauncher
    install — a CI runner, or a contributor who unzipped the distribution somewhere else — can build
    and test by pointing at a folder. This mirrors the resolution order Dalamud.NET.Sdk itself uses
    for the plugin project, so both halves of the solution agree on one answer.
  -->
  <PropertyGroup>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev</DalamudLibPath>
  </PropertyGroup>

  <Target Name="EnsureDalamudLibPathExists" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(DalamudLibPath)')"
           Text="Dalamud assemblies not found at &quot;$(DalamudLibPath)&quot;. Install XIVLauncher, or set DALAMUD_HOME to an unpacked https://goatcorp.github.io/dalamud-distrib/latest.zip — see CONTRIBUTING.md." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArsenalCleanup\ArsenalCleanup.csproj" />
    <!-- The plugin references Dalamud with Private="false", since the game process provides it at
         runtime. Tests run standalone, so they need their own copy-local reference to resolve the
         types the plugin's public signatures mention (GameInventoryType, and Lumina's sheet rows). -->
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)\Dalamud.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)\Lumina.Excel.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)\Lumina.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
